# Runtime env for the `crm-env` Secret. Copy OUTSIDE the repo, fill in,
#   kubectl -n salesdaily create secret generic crm-env --from-env-file=<file>
# and delete the filled copy. NEXT_PUBLIC_* are build args (GitHub repo
# variables), not listed here.
#
# ⚠ kubectl takes everything after `=` literally: no quotes, no trailing
# comments, no spaces around `=`. Comments go on their own lines only.

# ── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dev.salesdaily.ru
# SAME value as today — losing it bricks every stored source credential
CREDENTIALS_ENCRYPTION_KEY=
# openssl rand -base64 32
CRON_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=nylas
# required even with nylas (the Resend client is built at import)
RESEND_API_KEY=
RESEND_FROM=
NYLAS_API_KEY=
NYLAS_API_URI=
NYLAS_CLIENT_ID=
NYLAS_CALLBACK_URI=
NYLAS_GRANT_ID=

# ── OAuth sign-in ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Object storage (h3llo S3, any S3-compatible) ─────────────────────────
S3_ENDPOINT=https://storage.h3llo.cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional — only if the store names another region in an
# AuthorizationHeaderMalformed error (default us-east-1).
# S3_REGION=

# ── Telegram bootstrap bot (optional) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
